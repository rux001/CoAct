# Copy this file to .env and fill in the values, then:
#   set -a; source .env; set +a
# before running run_iteration.sh.

# --- HuggingFace ---
# Needed to download Llama-3-8B weights.
HF_TOKEN=hf_your_token_here
# Optional: override the HF cache location (default: $HOME/.cache/huggingface)
# HF_HOME=/path/to/hf/cache

# --- Azure OpenAI (oracle step) ---
AZURE_API_KEY=your_azure_openai_key
AZURE_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/gpt-5-chat/chat/completions?api-version=2025-01-01-preview
# Optional (defaults shown):
# AZURE_API_VERSION=2025-01-01-preview
# DEPLOYMENT_NAME=gpt-5-chat

# --- LLaMA-Factory checkout ---
LLAMAFACTORY_DIR=/abs/path/to/LLaMA-Factory

# --- GPUs ---
# Comma-separated device list used by vLLM and accelerate (default: 0,1,2,3)
# CUDA_VISIBLE_DEVICES=0,1,2,3
